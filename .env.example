# Copie este archivo a .env y complete los valores.
# En Railway: Project → servicio de la API → Variables (una por variable).

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase — proyecto. La service_role SOLO vive aquí (nunca en apps/web).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Opcional: solo si valida JWT con el secreto simétrico en vez de JWKS.
SUPABASE_JWT_SECRET=

# Orígenes permitidos para CORS, separados por coma, sin slash final.
# Debe incluir la URL pública que te da Vercel para el front.
# Local:      http://localhost:4321
# Producción: https://tu-proyecto.vercel.app
CORS_ORIGINS=http://localhost:4321

# URL pública del sitio (Astro en Vercel). La usa la API para construir
# links en correos y en el callback de firma del NDA.
PUBLIC_SITE_URL=http://localhost:4321

# Vigencia (segundos) de las URLs firmadas de Storage para ver/descargar
# documentos del Deal Room.
SIGNED_URL_TTL=300

# Secreto compartido para invocar jobs internos (p. ej. expiración de
# permisos) sin pasar por autenticación de usuario. Genere uno propio en
# producción — nunca deje el valor por defecto.
INTERNAL_JOB_SECRET=cambie-este-secreto-en-produccion

# Proveedores: 'mock' en desarrollo. Cambie a la opción real cuando exista
# un proveedor peruano/contratado — cada uno respeta la misma interfaz.
KYC_PROVIDER=mock
SCREENING_PROVIDER=mock
ESIGN_PROVIDER=mock
EMAIL_PROVIDER=mock
PAYMENTS_PROVIDER=mock

# Solo si EMAIL_PROVIDER=resend.
RESEND_API_KEY=
EMAIL_FROM=LUXUS PERU <private@luxusperu.com>

# Solo si PAYMENTS_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Solo si ESIGN_PROVIDER usa webhook de confirmación (no 'mock').
ESIGN_WEBHOOK_SECRET=cambie-este-secreto-en-produccion

{
  "name": "luxus-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LUXUS PERÚ — API (Fastify + TypeScript). Sirve al frontend de luxus-web.",
  "engines": { "node": ">=20.11" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run build -w @luxus/shared && npm run dev -w @luxus/api",
    "dev:shared": "npm run dev -w @luxus/shared",
    "build": "npm run build -w @luxus/shared && npm run build -w @luxus/api",
    "start": "npm run start -w @luxus/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "test": "npm run test --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/database.types.ts",
    "test:rls": "node --test --experimental-strip-types supabase/tests/rls.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
